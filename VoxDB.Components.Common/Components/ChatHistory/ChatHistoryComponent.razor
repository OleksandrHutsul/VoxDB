<div class="card">
    <div class="flex items-center justify-between mb-2">
        <h3>@(LanguageService.IsUa ? "Історія чатів" : "Chat History")</h3>
        <button class="btn" @onclick="Create">
            @(LanguageService.IsUa ? "Новий чат" : "New chat")
        </button>
    </div>

    @if (_sessions is null)
    {
        <p>@(LanguageService.IsUa ? "Завантаження…" : "Loading…")</p>
    }
    else
    {
        <div class="chat-history-scroll">
            @foreach (var s in _sessions)
            {
                <div class="chat-history-item @(SelectedId == s.Id ? "is-selected" : null)">
                    <button type="button"
                            class="chat-history-open"
                            title="@s.Title"
                            @onclick="() => Open(s.Id)">
                        <span class="chat-history-title">@s.Title</span>
                    </button>
                    <button type="button"
                            class="chat-history-delete"
                            title="@(LanguageService.IsUa ? "Видалити чат" : "Delete chat")"
                            aria-label="@(LanguageService.IsUa ? "Видалити чат" : "Delete chat")"
                            @onclick="() => Delete(s.Id)">
                        ✕
                    </button>
                </div>
            }
        </div>
    }
</div>
