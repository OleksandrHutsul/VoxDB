<div class="lang-toggle">
    <button class="lang-btn @(LanguageService.IsUa ? "active" : "")"
            @onclick=@(() => SetLangAsync("ua"))>
        UA
    </button>

    <button class="lang-btn @(LanguageService.IsEn ? "active" : "")"
            @onclick=@(() => SetLangAsync("en"))>
        EN
    </button>
</div>