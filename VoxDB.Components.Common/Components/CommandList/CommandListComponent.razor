@using VoxDB.Components.Common.Components.LanguageToggle
<div class="card" style="height: max-content;">
  <LanguageToggleComponent />
    <h3>@(LanguageService.IsUa ? "Команди (приклади)" : "Commands (examples)")</h3>
    <ul>
        @if (LanguageService.IsUa)
        {
            <li>“Покажи всіх працівників”</li>
            <li>“Додай працівника Іван Іванов”</li>
            <li>“Онови посаду працівника з ID 3 на менеджер”</li>
            <li>“Видали працівника з ID 5”</li>
        }
        else
        {
            <li>“Show all employees”</li>
            <li>“Add employee John Smith”</li>
            <li>“Update employee with ID 3 to manager”</li>
            <li>“Delete employee with ID 5”</li>
        }
    </ul>
</div>