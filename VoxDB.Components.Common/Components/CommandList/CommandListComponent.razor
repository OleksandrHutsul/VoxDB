@using VoxDB.Components.Common.Components.LanguageToggle
<div class="command-panel">
    <div class="command-toolbar">
        <LanguageToggleComponent />
    </div>
    <h3>@(LanguageService.IsUa ? "Команди" : "Commands")</h3>
    <p class="command-lead">@(LanguageService.IsUa ? "Спробуйте одну з цих команд" : "Try one of these commands")</p>
    <div class="command-list">
        @foreach (var example in Examples)
        {
            <button type="button" class="command-row" @onclick="() => SelectAsync(example.Text)">
                <span class="mark mark-@example.Kind" aria-hidden="true"></span>
                <span class="command-text">@example.Text</span>
            </button>
        }
    </div>
</div>
